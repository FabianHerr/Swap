# Copy to .env and fill in. Never commit .env.
MONGO_URI=mongodb://127.0.0.1:27017
JWT_SECRET=replace-with-a-long-random-string
PORT=3001
# Frontend URL(s) allowed by CORS, comma-separated. Defaults to http://localhost:5173.
CLIENT_ORIGIN=http://localhost:5173
# Optional: AI fallback for the offer parser (free key at https://aistudio.google.com/apikey).
# Without it, the parser uses rules only and asks the user to finish the form when text is ambiguous.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
