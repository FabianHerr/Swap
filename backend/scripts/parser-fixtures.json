{
  "about": "Offer parser cases. expect \"rules\": the rules alone must return exactly `fields` (missing keys must be absent). expect \"flag\": the text is ambiguous; any returned field must be one of the values in `ok` (a key missing from `ok` must be absent), and there must be at least one warning.",
  "cases": [
    { "text": "I have 250 EUR and want 370 CAD", "expect": "rules",
      "fields": { "giveAmount": 250, "giveCurrency": "EUR", "wantAmount": 370, "wantCurrency": "CAD" } },
    { "text": "j'ai 250 euros, je cherche 370 dollars canadiens", "expect": "rules",
      "fields": { "giveAmount": 250, "giveCurrency": "EUR", "wantAmount": 370, "wantCurrency": "CAD" } },
    { "text": "Tengo 3 millones de pesos colombianos, busco 1050 dólares canadienses", "expect": "rules",
      "fields": { "giveAmount": 3000000, "giveCurrency": "COP", "wantAmount": 1050, "wantCurrency": "CAD" } },
    { "text": "Selling 2k USD for 2,700 CAD", "expect": "rules",
      "fields": { "giveAmount": 2000, "giveCurrency": "USD", "wantAmount": 2700, "wantCurrency": "CAD" } },
    { "text": "€500 -> £430", "expect": "rules",
      "fields": { "giveAmount": 500, "giveCurrency": "EUR", "wantAmount": 430, "wantCurrency": "GBP" } },
    { "text": "Looking for 300 CAD, have 220 EUR", "expect": "rules",
      "fields": { "giveAmount": 220, "giveCurrency": "EUR", "wantAmount": 300, "wantCurrency": "CAD" } },
    { "text": "Need 1.150.000 COP, I've got 400 CAD", "expect": "rules",
      "fields": { "giveAmount": 400, "giveCurrency": "CAD", "wantAmount": 1150000, "wantCurrency": "COP" } },
    { "text": "1.200,50 EUR for 1 750 CAD", "expect": "rules",
      "fields": { "giveAmount": 1200.5, "giveCurrency": "EUR", "wantAmount": 1750, "wantCurrency": "CAD" } },
    { "text": "I have 400 CAD, want pesos colombianos", "expect": "rules",
      "fields": { "giveAmount": 400, "giveCurrency": "CAD", "wantCurrency": "COP" } },
    { "text": "Je vends 1000 dirhams contre 95 euros", "expect": "rules",
      "fields": { "giveAmount": 1000, "giveCurrency": "MAD", "wantAmount": 95, "wantCurrency": "EUR" } },
    { "text": "Quiero 800 reais, tengo 150 USD", "expect": "rules",
      "fields": { "giveAmount": 150, "giveCurrency": "USD", "wantAmount": 800, "wantCurrency": "BRL" } },
    { "text": "5000 yen for 45 bucks", "expect": "rules",
      "fields": { "giveAmount": 5000, "giveCurrency": "JPY", "wantAmount": 45, "wantCurrency": "USD" } },
    { "text": "Swapping 20000 INR to 330 AUD", "expect": "rules",
      "fields": { "giveAmount": 20000, "giveCurrency": "INR", "wantAmount": 330, "wantCurrency": "AUD" } },
    { "text": "have 3 mil pesos mexicanos want 150 USD", "expect": "rules",
      "fields": { "giveAmount": 3000, "giveCurrency": "MXN", "wantAmount": 150, "wantCurrency": "USD" } },
    { "text": "US$ 600 for C$ 800", "expect": "rules",
      "fields": { "giveAmount": 600, "giveCurrency": "USD", "wantAmount": 800, "wantCurrency": "CAD" } },
    { "text": "tengo 500 soles, necesito 130 dólares americanos", "expect": "rules",
      "fields": { "giveAmount": 500, "giveCurrency": "PEN", "wantAmount": 130, "wantCurrency": "USD" } },
    { "text": "2 grand CAD for 1,400 EUR", "expect": "rules",
      "fields": { "giveAmount": 2000, "giveCurrency": "CAD", "wantAmount": 1400, "wantCurrency": "EUR" } },
    { "text": "want 500 USD", "expect": "rules",
      "fields": { "wantAmount": 500, "wantCurrency": "USD" } },
    { "text": "have 1000000000 COP want 100 CAD", "expect": "rules",
      "fields": { "giveCurrency": "COP", "wantAmount": 100, "wantCurrency": "CAD" } },
    { "text": "I have 50 GBP and want GBP", "expect": "rules",
      "fields": { "giveAmount": 50, "giveCurrency": "GBP" } },
    { "text": "want 50 USD for my 70 CAD", "expect": "rules",
      "fields": { "giveAmount": 70, "giveCurrency": "CAD", "wantAmount": 50, "wantCurrency": "USD" } },
    { "text": "400 CAD (canadian dollars) for 290 USD", "expect": "rules",
      "fields": { "giveAmount": 400, "giveCurrency": "CAD", "wantAmount": 290, "wantCurrency": "USD" } },

    { "text": "300 pesos for dollars", "expect": "flag",
      "ok": { "giveAmount": [300], "giveCurrency": ["MXN", "COP", "ARS", "CLP", "DOP", "PHP"], "wantCurrency": ["USD", "CAD", "AUD"] } },
    { "text": "I have 200 dollars, want 250 euros", "expect": "flag",
      "ok": { "giveAmount": [200], "giveCurrency": ["USD", "CAD", "AUD"], "wantAmount": [250], "wantCurrency": ["EUR"] } },
    { "text": "100 francs for 90 euros", "expect": "flag",
      "ok": { "giveAmount": [100], "giveCurrency": ["CHF", "XOF"], "wantAmount": [90], "wantCurrency": ["EUR"] } },
    { "text": "200 USD, 180 EUR or 260 CAD", "expect": "flag",
      "ok": { "giveAmount": [200, 180, 260], "giveCurrency": ["USD", "EUR", "CAD"], "wantAmount": [200, 180, 260], "wantCurrency": ["USD", "EUR", "CAD"] } },
    { "text": "call me at 555 1234", "expect": "flag", "ok": {} },
    { "text": "250 EUR 370 CAD", "expect": "flag",
      "ok": { "giveAmount": [250, 370], "giveCurrency": ["EUR", "CAD"], "wantAmount": [250, 370], "wantCurrency": ["EUR", "CAD"] } }
  ]
}
